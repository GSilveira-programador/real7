DATABASE_URL=postgresql://elite:change-me@localhost:5432/elite_boots
APP_URL=http://localhost:3000
# Set false in production. Demo products remain explicitly labeled.
DEMO_MODE=true
# Mercado Pago hosted checkout; never send these to the browser.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Melhor Envio API bearer token, production or sandbox base URL
SHIPPING_API_URL=https://sandbox.melhorenvio.com.br/api/v2
SHIPPING_TOKEN=
SHIPPING_ORIGIN_POSTCODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Admin creation reads these only during the command; do not commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 32-byte random hex key; back up securely, never rotate without migrating MFA, checkout and newsletter ciphertexts.
MFA_ENCRYPTION_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Mercado Pago account ID, required before commercial activation
MP_COLLECTOR_ID=

# Operational MFA recovery: trusted server operator only, never an HTTP endpoint.
RECOVERY_EMAIL=
RECOVERY_REASON=
RECOVERY_CONFIRM=
RECOVERY_OPERATOR=
